# Arcradient Toolchain: Legacy Windows 2000 SP4 (32-bit x86 + Pentium III SSE1)
# Usage: cmake -B build-win2k -DCMAKE_TOOLCHAIN_FILE=cmake/toolchains/win2000-x86-sse1.cmake
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR i686)

set(CMAKE_C_COMPILER i686-w64-mingw32-gcc)
set(CMAKE_RC_COMPILER i686-w64-mingw32-windres)

set(ARCR_LEGACY_X86_WIN2000 ON CACHE BOOL "Target Windows 2000 SP4 x86 SSE1" FORCE)
set(ARCR_BASELINE_X64_SSE3 OFF CACHE BOOL "" FORCE)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
